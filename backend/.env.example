# ── GlobeTrotter Backend Environment Variables ──
# Copy this file to .env and fill in your values.

# Neon DB connection string (use postgresql+asyncpg:// prefix)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# JWT Configuration
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File uploads
UPLOAD_DIR=./uploads

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# App
APP_NAME=GlobeTrotter
DEBUG=true
