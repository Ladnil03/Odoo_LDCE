# ── GlobeTrotter Backend Environment Variables ──
# Copy this file to .env and fill in your values.

# Neon DB connection string (use postgresql+asyncpg:// prefix)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# JWT Configuration
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File uploads & Cloudinary
UPLOAD_DIR=./uploads
# Option 1: Full Cloudinary URL
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Option 2: Individual keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# App
APP_NAME=GlobeTrotter
DEBUG=true
